# Copy this file to .env (or export these in your shell / hosting provider's
# environment-variable settings) before running the app.

# The spreadsheet ID from the sheet's URL:
#   https://docs.google.com/spreadsheets/d/  THIS_PART  /edit
GOOGLE_SHEET_ID=

# --- Service account credentials: use ONE of the two options below ---

# Option A: paste the entire contents of the downloaded JSON key file as one
# line (this is the easiest option for most hosting providers' "environment
# variable" UIs, e.g. Render, Railway, Fly.io, Heroku).
GOOGLE_SERVICE_ACCOUNT_JSON=

# Option B: instead, point at a JSON key file sitting on disk next to app.py.
# Leave GOOGLE_SERVICE_ACCOUNT_JSON blank if you use this.
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Optional: re-fetch the sheet automatically every N minutes in the
# background, in addition to the "Refresh from Google Sheet" button.
# Leave blank to only refresh when someone clicks the button.
AUTO_REFRESH_MINUTES=

# Ordinary Flask server settings
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
